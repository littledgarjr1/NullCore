{
	"geode": "5.9.0",
	"gd": {
		"win": "2.2081",
		"android": "2.2081",
		"mac": "2.2081",
		"ios": "2.2081"
	},
	"id": "inullexx.nullcore",
	"name": "NullCore",
	"version": "v0.1.3",
	"developer": "iNullexx",
	"description": "A mod menu for Geometry Dash.",
	"dependencies": {
		"geode.node-ids": ">=v1.23.3"
	},
	"resources": {
		"sprites": [
			"resources/*.png",
			"resources/MenuImages/*.png"
		],
		"fonts": {
			"FredokaOne": {
				"path": "resources/fonts/FredokaOne.ttf",
				"size": 48,
				"outline": 4
			},
			"Rubik": {
				"path": "resources/fonts/Rubik.ttf",
				"size": 48,
				"outline": 4
			},
			"Arial": {
				"path": "resources/fonts/Arimo.ttf",
				"size": 48,
				"outline": 4
			},
			"PressStart2P": {
				"path": "resources/fonts/PressStart2P.ttf",
				"size": 48,
				"outline": 4
			},
			"ChopinScript": {
				"path": "resources/fonts/DancingScript.ttf",
				"size": 48,
				"outline": 4
			}
		}
	},
	"settings": {
		"theme": {
			"type": "string",
			"name": "Theme",
			"description": "Light = white menus. Dark = black menus. Both use black, white and grey only.",
			"default": "Light",
			"one-of": [
				"Light",
				"Dark"
			]
		},
		"font": {
			"type": "string",
			"name": "Font",
			"description": "Font used in NullCore's menus.",
			"default": "Pusab",
			"one-of": [
				"Pusab",
				"FredokaOne",
				"Rubik",
				"Arial",
				"PressStart2P",
				"Chopin Script"
			]
		},
		"show-button": {
			"type": "bool",
			"name": "Show floating button",
			"description": "Show the draggable NullCore button on screen. Tap it to open the menu.",
			"default": true
		},
		"button-size": {
			"type": "string",
			"name": "Button size",
			"description": "How big the floating button is.",
			"default": "Small",
			"one-of": [
				"Small",
				"Medium",
				"Large"
			]
		},
		"button-opacity": {
			"type": "float",
			"name": "Button opacity",
			"description": "How see-through the floating button is.",
			"default": 1.0,
			"min": 0.2,
			"max": 1.0
		},
		"check-updates": {
			"type": "bool",
			"name": "Check for updates on startup",
			"description": "Look for a newer NullCore build when the game starts.",
			"default": true
		}
	}
}